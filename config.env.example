# Copy to .env and fill in. All scripts read .env from the repo root.

# Sleeper league ID (find it in the league URL: sleeper.com/leagues/<ID>/...)
# This league is public, so the real ID lives here too: "Injury Prone", 10-team half-PPR.
SLEEPER_LEAGUE_ID=1384188162011566080

# FantasyPros API key (optional — request a free key at fantasypros.com/apis)
# Free tier: 50 requests/day. Without it, ADP comes from Fantasy Football Calculator only.
FANTASYPROS_API_KEY=

# League size — drives ADP fetch format and positional scarcity analysis
LEAGUE_TEAMS=10

# Scoring format for ADP sources: ppr, half-ppr, standard, or 2qb
ADP_FORMAT=half-ppr
