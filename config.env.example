# Copy to .env and fill in. All scripts read .env from the repo root.

# Sleeper league ID (find it in the league URL: sleeper.com/leagues/<ID>/...)
SLEEPER_LEAGUE_ID=

# FantasyPros API key (optional — request a free key at fantasypros.com/apis)
# Without it, ADP comes from Fantasy Football Calculator only.
FANTASYPROS_API_KEY=

# League size — drives ADP fetch format and positional scarcity analysis
LEAGUE_TEAMS=8
